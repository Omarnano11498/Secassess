__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
# Reports and audit logs may contain internal addresses; keep them out of VCS.
*.json
*.docx
