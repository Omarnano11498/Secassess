secassess-audit.log
*.log
# Real scan scopes describe private networks; only the documentation-range example is tracked.
config/*.toml
!config/example.toml
*scope*.toml
reports/
advisories/
# Raw Nmap output.
*.nmap
*.gnmap
*.xml
